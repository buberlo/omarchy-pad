#!/bin/sh
# Starts the Omarchy desktop inside the running Omarchy Pad guest.
#
# Launched by the iOS app's canvas (through ishwl's spawn channel) or by hand:
#     omarchy-pad-session            Omarchy's own configuration, iPad overrides on top
#     omarchy-pad-session --minimal  a bare headless Hyprland for bring-up and tests
#
# Hyprland owns one headless output; `omarchy-pad-bridge` copies that output into an
# ishwl surface (the native iPad window) and injects the iPad's input back. Nothing here
# needs a DRM card, a seat, udev or systemd.
set -eu

MINIMAL=0
if [ "${1:-}" = "--minimal" ]; then
    MINIMAL=1
fi

RUNDIR=/run/omarchy-pad
LOG=$RUNDIR/session.log
mkdir -p "$RUNDIR"
: >>"$LOG"
log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" | tee -a "$LOG"; }

# What the canvas shows while it waits for the desktop's first window, and what it reports
# when the session gave up. The app reads these as host files of the shared guest
# filesystem, so they are plain text and never commands.
STATUS=/tmp/omarchy-pad/status
ERROR=/tmp/omarchy-pad/error
mkdir -p /tmp/omarchy-pad
status() { printf '%s\n' "$*" >"$STATUS" 2>/dev/null || true; }
fail() {
    printf '%s\n' "$*" >"$ERROR" 2>/dev/null || true
    status "$*"
    log "failed: $*"
}
rm -f "$ERROR"
status "starting Hyprland"

# --- environment ----------------------------------------------------------------------
# ishwl's socket, captured before Hyprland's value replaces WAYLAND_DISPLAY below: the
# bridge is a client of both compositors and needs to be told which one is which.
ISHWL_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export HOME=/root USER=root LOGNAME=root SHELL=/bin/sh
# The app starts this through ishwl's spawn channel. ishwl hands its own environment over
# (the supervisor runs the request, so nothing is inherited implicitly), and these are the
# values it uses -- ishwl-session's XDG_RUNTIME_DIR and ishwl's default socket name -- so a
# manual run lands on the same compositor. Only an explicit override wins.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg-runtime}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export OMARCHY_PATH=/usr/share/omarchy
export PATH=$OMARCHY_PATH/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
chmod 700 "$XDG_RUNTIME_DIR"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -r "$RUNDIR/dbus-address" ]; then
    DBUS_SESSION_BUS_ADDRESS=$(cat "$RUNDIR/dbus-address")
    export DBUS_SESSION_BUS_ADDRESS
fi

# Omarchy/Quickshell expect a handful of variables and prefer Wayland for every toolkit.
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export NO_AT_BRIDGE=1 GTK_A11Y=none GIO_USE_VFS=local

# Software rendering is allowed because the guest's GL is a render node driven by zink on
# Venus; Hyprland's own software classification patch is what Omarchy ships.
export WLR_RENDERER_ALLOW_SOFTWARE=1
# Hyprland refuses to run as root without this flag. There is no login session, no seat and
# no privilege boundary to protect inside the emulator, and the whole guest runs as root
# (the same choice LinPad's Alpine session makes), so the flag is the honest answer.
ROOT_FLAG=""
if [ "$(id -u)" = 0 ]; then
    ROOT_FLAG=--i-am-really-stupid
fi
# Hyprland needs a GLES 3.0 context. The guest's GPU is Mesa's zink on Venus, which reports
# ES 2.0 unless the version is overridden; with the override the context is genuinely 3.0
# and Hyprland's shaders compile. (LinPad's Alpine session does the same for its apps.)
export MESA_GLES_VERSION_OVERRIDE=${MESA_GLES_VERSION_OVERRIDE:-3.0}
# The patched Hyprland creates its headless output from this variable rather than from a
# monitor rule: `monitor = HEADLESS-1, …` alone does not create it, and hyprctl cannot be
# relied on inside the emulator. The bridge also creates the output over Hyprland's IPC if
# it is missing, so either path gets there.
export HYPR_PAD_HEADLESS_OUTPUT=${HYPR_PAD_HEADLESS_OUTPUT:-HEADLESS-1}
# The timerfd deadlock fix is in the engine now; the workaround stays available for older
# builds, and the patched aquamarine detects iSH by itself.
export AQ_HEADLESS_NO_TIMERFD=${AQ_HEADLESS_NO_TIMERFD:-1}
# The GPU hook the image ships: Venus ICD, zink, software WSI. Sourced with an if, not an
# `A && B` list: under `set -e` a missing file would end the script silently, which is
# exactly how the first device run lost its session.
# Which rasteriser to start on.
#
# The GPU path is real and much faster where it works -- Hyprland renders through zink on
# Venus, and the probe in installation/omarchy/probe-gl.sh proves frames come out -- but it is
# not yet safe to assume. On the iOS simulator's Vulkan device zink cannot create a graphics
# pipeline at all (no VK_EXT_depth_clip_enable) and its memory footprint killed the whole app
# before the session could react, so software is the default and the GPU is opted into with
# /etc/omarchy-pad/gpu (or OMARCHY_PAD_GPU=1). A device that has been measured with the GPU is
# where that file belongs; the frame check further down still falls back if it misbehaves.
if [ "${OMARCHY_PAD_SOFTWARE:-0}" = 1 ] || { [ "${OMARCHY_PAD_GPU:-0}" != 1 ] && [ ! -e /etc/omarchy-pad/gpu ]; }; then
    OMARCHY_PAD_SOFTWARE=1
    export OMARCHY_PAD_SOFTWARE
    MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
    export MESA_LOADER_DRIVER_OVERRIDE
fi
if [ -r /etc/profile.d/gpu.sh ]; then
    . /etc/profile.d/gpu.sh
fi

# --- the compositor -------------------------------------------------------------------
if [ "$MINIMAL" = 0 ]; then
    # Omarchy's provisioning normally seeds the owner's configuration; this image may have
    # booted without it, so make the session self-healing rather than start Hyprland with no
    # config at all. -n never overwrites anything already there.
    mkdir -p "$HOME/.config/hypr" "$HOME/.local/state/omarchy/toggles/hypr"
    [ -d "$OMARCHY_PATH/config/hypr" ] && cp -rn "$OMARCHY_PATH/config/hypr/." "$HOME/.config/hypr/" 2>/dev/null || true
    for t in no-animations window-opaque; do
        [ -f "$OMARCHY_PATH/default/hypr/toggles/$t.lua" ] &&
            cp -n "$OMARCHY_PATH/default/hypr/toggles/$t.lua" "$HOME/.local/state/omarchy/toggles/hypr/" 2>/dev/null || true
    done
fi

if [ "$MINIMAL" = 1 ]; then
    CONFIG=/usr/share/omarchy-pad/hyprland-pad.conf
    log "starting Hyprland with the bring-up config $CONFIG"
else
    CONFIG=""
    log "starting Hyprland with Omarchy's configuration"
fi

# Hyprland's clients must reach *Hyprland*, not ishwl. The session inherits ishwl's
# environment, where WAYLAND_DISPLAY is ishwl's own socket (wayland-0), and Hyprland passes
# its environment to everything it starts -- Omarchy's shell (autostart.lua runs
# omarchy-launch-shell), every exec-once, every app launched from the desktop. With the
# inherited value they all attached to ishwl instead: Quickshell's bar and background never
# became part of the composited output, nothing damaged the headless output, and the canvas
# showed a still frame of an empty desktop. Naming Hyprland's socket explicitly (wayland-1,
# because ishwl holds wayland-0) makes its children land on the right compositor.
# Stale sockets and instance directories from a previous session would confuse the discovery
# in hyprctl and Omarchy's own scripts, so they are cleared first: the session starts the
# compositor itself, and any surviving Hyprland was already stopped by the caller.
rm -rf "$XDG_RUNTIME_DIR/hypr" "$XDG_RUNTIME_DIR/wayland-1" "$XDG_RUNTIME_DIR/wayland-1.lock"
export WAYLAND_DISPLAY=${HYPR_PAD_DISPLAY:-wayland-1}
log "starting Hyprland on $WAYLAND_DISPLAY"

if [ -n "$CONFIG" ]; then
    hyprland ${ROOT_FLAG} -c "$CONFIG" >>"$LOG" 2>&1 &
else
    hyprland ${ROOT_FLAG} >>"$LOG" 2>&1 &
fi
HYPRLAND_PID=$!
log "hyprland pid $HYPRLAND_PID"

# Wait for the compositor to answer before the bridge connects: the shell in Omarchy does
# exactly this (bin/omarchy-launch-shell), and it is the only reliable readiness signal.
tries=0
while [ "$tries" -lt 300 ]; do
    if ! kill -0 "$HYPRLAND_PID" 2>/dev/null; then
        log "hyprland exited before it answered"
        fail "Hyprland exited before it answered; see $LOG"
        exit 1
    fi
    # Two signals, because either can be the only one available: hyprctl answering, or the
    # compositor's own Wayland socket existing. hyprctl used to fail in the guest on
    # setsockopt(SO_RCVTIMEO) (fixed in the engine, but an older build must still boot), and
    # the socket is what the bridge actually needs.
    ready=0
    if hyprctl -j monitors >/dev/null 2>&1; then
        ready=1
    else
        for s in "$XDG_RUNTIME_DIR"/hypr/*/.socket.sock; do
            [ -S "$s" ] && ready=1
        done
    fi
    if [ "$ready" = 1 ]; then
        log "hyprland is answering after ${tries}s"
        status "Hyprland is up (${tries}s); starting the display bridge"
        break
    fi
    tries=$((tries + 1))
    sleep 1
done
[ "$tries" -lt 300 ] || {
    fail "Hyprland did not answer within 300s; see $LOG"
    exit 1
}

# --- the display/input bridge ---------------------------------------------------------
# --ishwl-socket is passed explicitly: the bridge defaults it to $WAYLAND_DISPLAY, which is
# Hyprland's socket by now (see above), and it then excludes that socket from the candidates
# it tries as "Hyprland" -- so it looked at ishwl's sockets only and never found the
# compositor. ISHWL_DISPLAY was captured before WAYLAND_DISPLAY was overwritten.
if command -v omarchy-pad-bridge >/dev/null 2>&1; then
    log "starting omarchy-pad-bridge (ishwl socket $ISHWL_DISPLAY, hyprland socket $WAYLAND_DISPLAY)"
    omarchy-pad-bridge --ishwl-socket "$ISHWL_DISPLAY" >>"$LOG" 2>&1 &
    log "bridge pid $!"
    status "the desktop is on screen"
else
    log "omarchy-pad-bridge is not installed yet; the desktop runs headless"
    fail "omarchy-pad-bridge is not installed in this root"
fi
BRIDGE_PID=$!

# --- does the driver actually render? ---------------------------------------------------
# A compositor that stays up is not the same as a desktop. On the iOS simulator's GPU, zink
# cannot create a graphics pipeline at all (that Vulkan device has no
# VK_EXT_depth_clip_enable, so vkCreateGraphicsPipelines answers VK_ERROR_FEATURE_NOT_PRESENT
# and Mesa logs "ZINK: vkCreateGraphicsPipelines failed"): Hyprland runs, the bridge connects,
# and no frame is ever produced. Watch what the bridge reports and come back on the software
# rasteriser rather than leaving an empty canvas.
if [ "${OMARCHY_PAD_SOFTWARE:-0}" != 1 ]; then
    frames=0
    waited=0
    while [ "$waited" -lt 45 ]; do
        kill -0 "$BRIDGE_PID" 2>/dev/null || break
        # An immediate, unambiguous verdict: Mesa could not create a pipeline, so nothing will
        # ever be drawn (the iOS simulator's Vulkan device has no VK_EXT_depth_clip_enable).
        # Waiting the full 45 s here does not just waste time: the GPU path also holds far more
        # memory, and the simulator's ~900 MB guest limit killed the whole app before the wait
        # was over.
        if grep -qE "vkCreateGraphicsPipelines failed|Framebuffer incomplete" "$LOG" 2>/dev/null; then
            log "the driver could not create a pipeline; giving up on it before it exhausts memory"
            frames=0
            waited=0
            break
        fi
        frames=$(sed -n 's/^frames=//p' "$STATUS" 2>/dev/null | head -1)
        case ${frames:-} in
        '' | *[!0-9]*) frames=0 ;;
        esac
        [ "$frames" -gt 0 ] && break
        sleep 3
        waited=$((waited + 3))
    done
    if kill -0 "$BRIDGE_PID" 2>/dev/null && [ "$frames" -eq 0 ] && kill -0 "$HYPRLAND_PID" 2>/dev/null; then
        log "no frame within ${waited}s on $MESA_LOADER_DRIVER_OVERRIDE; restarting the session on the software rasteriser"
        status "the GPU driver produced no frame; restarting the desktop in software"
        kill "$BRIDGE_PID" 2>/dev/null || true
        kill "$HYPRLAND_PID" 2>/dev/null || true
        sleep 2
        OMARCHY_PAD_SOFTWARE=1 MESA_LOADER_DRIVER_OVERRIDE=llvmpipe exec "$0" "$@"
    fi
    log "the desktop produced frames (${frames} so far) on ${MESA_LOADER_DRIVER_OVERRIDE:-default}"
fi

# --- if the compositor dies, come back on the software rasteriser ---------------------
# A GPU driver that cannot allocate the compositor's own framebuffers kills it (zink on Venus
# did, until the stencil patch: depth/stencil storage failed and Hyprland aborted on its first
# frame). The canvas would sit empty with no way back, so the session restarts itself once
# with llvmpipe and records which driver it ended up on: a slow desktop is a desktop, a black
# window is not. Anything the renderer does not need -- this is not a retry loop; the second
# attempt is final, whatever it does.
wait "$HYPRLAND_PID"
log "hyprland exited"
if [ "${OMARCHY_PAD_SOFTWARE:-0}" != 1 ]; then
    log "restarting the session on the software rasteriser (MESA_LOADER_DRIVER_OVERRIDE=llvmpipe)"
    status "the compositor exited; restarting the desktop in software"
    kill "$BRIDGE_PID" 2>/dev/null || true
    OMARCHY_PAD_SOFTWARE=1 MESA_LOADER_DRIVER_OVERRIDE=llvmpipe exec "$0" "$@"
fi
log "hyprland exited again on the software rasteriser; leaving the session down"
