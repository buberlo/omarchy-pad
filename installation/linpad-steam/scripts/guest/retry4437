#!/bin/sh
set -eu
wget -q http://192.168.0.104:8765/taskset-wrapper -O /usr/local/bin/taskset
chmod +x /usr/local/bin/taskset
for p in 2590 2679; do
    if [ -r "/proc/$p/cmdline" ] && tr '\000' ' ' < "/proc/$p/cmdline" | grep -q '/root/.local/share/Steam/steamrtarm64/steam'; then kill "$p" 2>/dev/null || true; fi
done
sleep 4
for p in 2590 2679; do
    if [ -r "/proc/$p/cmdline" ] && tr '\000' ' ' < "/proc/$p/cmdline" | grep -q '/root/.local/share/Steam/steamrtarm64/steam'; then kill -9 "$p" 2>/dev/null || true; fi
done
sleep 2
STEAM_PIPE_DIAGNOSTIC=1 STEAM_PIPE_PACKET_FALLBACK=1 steam-local >/tmp/steam-local.log 2>&1 &
echo "RETRY_PID=$!"
