diff --git a/tests/manual/steam-compat/README.md b/tests/manual/steam-compat/README.md
new file mode 100644
index 0000000..1994843
--- /dev/null
+++ b/tests/manual/steam-compat/README.md
@@ -0,0 +1,25 @@
+# Steam/FEX compatibility probes
+
+These standalone guest programs exercise runtime contracts used during Steam
+startup. Compile the native probes for AArch64 Linux. A static musl build is
+convenient for running them under both the CLI emulator and iPad app.
+
+- `runtime-probe.c`: MIDR_EL1 and relative faccessat through pipe, file and
+  directory descriptors. Requires `/opt/fex/hello-x86_64` to exist.
+- `eventfd-probe.c`: semaphore reads, ordinary counter reads, nonblocking
+  exhaustion and epoll readiness.
+- `pselect-probe.c`: null and packed-null signal masks, empty and ready pipes.
+- `epoll-oneshot-probe.c`: registrations persist after delivery, MOD rearms
+  an already-ready edge and updates data, DEL accepts disabled registrations,
+  and hangup stays disabled until rearmed.
+- `pthread-glibc-probe.c`: dynamic glibc thread creation with different stack
+  sizes and repeated joins. Link against glibc and run with the isolated
+  matching loader/libraries; it does not alter the musl system runtime.
+- `x86-runtime-smoke.c`: compile for x86-64 Linux with pthread support and run
+  through FEX. Checks threads/mutexes, SSE2 arithmetic, generated executable
+  code and signal delivery. This does not qualify a full application or game.
+
+The pselect and epoll probes passed in the Mac CLI and on the physical M2 iPad.
+With the approved memory entitlements and `ulimit -s 8192`, all three FEX-static
+variants at upstream revision 5285020de passed the x86 runtime smoke test on
+the iPad. These results do not establish that Steam's Chromium UI works.
diff --git a/tests/manual/steam-compat/epoll-oneshot-probe.c b/tests/manual/steam-compat/epoll-oneshot-probe.c
new file mode 100644
index 0000000..200ebee
--- /dev/null
+++ b/tests/manual/steam-compat/epoll-oneshot-probe.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <sys/epoll.h>
+#include <sys/eventfd.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <errno.h>
+static int failures;
+static void check(const char *name,int ok) { printf("%s %s errno=%d\n",name,ok?"PASS":"FAIL",errno);failures+=!ok; }
+int main(void) {
+    int ep=epoll_create1(0), e=eventfd(1,EFD_NONBLOCK),p[2];
+    if(ep<0||e<0||pipe(p))return 90;
+    struct epoll_event ev={.events=EPOLLIN|EPOLLONESHOT|EPOLLET,.data.u64=123},out;
+    check("eventfd add",epoll_ctl(ep,EPOLL_CTL_ADD,e,&ev)==0);
+    check("initial event",epoll_wait(ep,&out,1,0)==1&&out.data.u64==123);
+    check("oneshot remains registered",epoll_ctl(ep,EPOLL_CTL_ADD,e,&ev)==-1&&errno==EEXIST);
+    check("disabled no delivery",epoll_wait(ep,&out,1,0)==0);
+    ev.data.u64=456;
+    check("MOD rearm",epoll_ctl(ep,EPOLL_CTL_MOD,e,&ev)==0);
+    check("rearm ready edge and data",epoll_wait(ep,&out,1,0)==1&&out.data.u64==456);
+    check("DEL disabled",epoll_ctl(ep,EPOLL_CTL_DEL,e,0)==0);
+    ev=(struct epoll_event){.events=EPOLLIN|EPOLLONESHOT,.data.u64=789};
+    check("pipe add",epoll_ctl(ep,EPOLL_CTL_ADD,p[0],&ev)==0);close(p[1]);
+    check("HUP initial",epoll_wait(ep,&out,1,0)==1&&(out.events&EPOLLHUP));
+    check("HUP disabled",epoll_wait(ep,&out,1,0)==0);
+    check("HUP rearm MOD",epoll_ctl(ep,EPOLL_CTL_MOD,p[0],&ev)==0);
+    check("HUP after MOD",epoll_wait(ep,&out,1,0)==1&&(out.events&EPOLLHUP));
+    close(p[0]);close(e);close(ep);return failures;
+}
diff --git a/tests/manual/steam-compat/eventfd-probe.c b/tests/manual/steam-compat/eventfd-probe.c
new file mode 100644
index 0000000..8d9655a
--- /dev/null
+++ b/tests/manual/steam-compat/eventfd-probe.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+#include <sys/eventfd.h>
+#include <sys/epoll.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+    int fd = eventfd(2, EFD_SEMAPHORE | EFD_NONBLOCK | EFD_CLOEXEC);
+    printf("eventfd semaphore create: fd=%d errno=%d\n", fd, errno);
+    if (fd < 0) return 1;
+    int pollfd = epoll_create1(EPOLL_CLOEXEC);
+    struct epoll_event event = {.events = EPOLLIN, .data.fd = fd};
+    if (epoll_ctl(pollfd, EPOLL_CTL_ADD, fd, &event)) return 2;
+    if (epoll_wait(pollfd, &event, 1, 0) != 1) return 3;
+    for (int i = 0; i < 2; i++) {
+        uint64_t value = 0;
+        if (read(fd, &value, sizeof(value)) != sizeof(value) || value != 1) return 4;
+    }
+    uint64_t value = 0;
+    if (read(fd, &value, sizeof(value)) != -1 || errno != EAGAIN) return 5;
+    if (epoll_wait(pollfd, &event, 1, 0) != 0) return 6;
+    close(pollfd); close(fd);
+    fd = eventfd(2, EFD_NONBLOCK);
+    if (fd < 0 || read(fd, &value, sizeof(value)) != sizeof(value) || value != 2) return 7;
+    close(fd);
+    puts("EVENTFD_SEMAPHORE_AND_COUNTER_OK");
+    return 0;
+}
diff --git a/tests/manual/steam-compat/pselect-probe.c b/tests/manual/steam-compat/pselect-probe.c
new file mode 100644
index 0000000..cc69bf2
--- /dev/null
+++ b/tests/manual/steam-compat/pselect-probe.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <sys/select.h>
+#include <sys/syscall.h>
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <stdint.h>
+int main(void) {
+    int p[2], failures=0;
+    if (pipe(p)) return 90;
+    for(int packed=0;packed<2;packed++) {
+        struct { uint64_t ptr,size; } mask={0,8};
+        fd_set fds; FD_ZERO(&fds); FD_SET(p[0],&fds);
+        struct timespec ts={0,0}; errno=0;
+        long r=syscall(SYS_pselect6,p[0]+1,&fds,0,0,&ts,packed?&mask:0);
+        printf("pselect6 empty mask=%s result=%ld errno=%d\n",packed?"packed-null":"null",r,errno);
+        failures+=r!=0;
+        write(p[1],"x",1); FD_ZERO(&fds); FD_SET(p[0],&fds); ts=(struct timespec){0,0};errno=0;
+        r=syscall(SYS_pselect6,p[0]+1,&fds,0,0,&ts,packed?&mask:0);
+        printf("pselect6 ready mask=%s result=%ld errno=%d\n",packed?"packed-null":"null",r,errno);
+        failures+=r!=1 || !FD_ISSET(p[0],&fds);
+        char c;read(p[0],&c,1);
+    }
+    close(p[0]);close(p[1]);return failures;
+}
diff --git a/tests/manual/steam-compat/pthread-glibc-probe.c b/tests/manual/steam-compat/pthread-glibc-probe.c
new file mode 100644
index 0000000..b50dffb
--- /dev/null
+++ b/tests/manual/steam-compat/pthread-glibc-probe.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+static void *worker(void *arg) {return arg;}
+int main(void) {
+    setbuf(stdout,NULL);
+    for(int round=0;round<10;round++) {
+        pthread_t threads[16];
+        for(int i=0;i<16;i++) {
+            pthread_attr_t attr;pthread_attr_init(&attr);
+            size_t sizes[]={0,65536,1024*1024,8*1024*1024};
+            if(sizes[i%4])pthread_attr_setstacksize(&attr,sizes[i%4]);
+            size_t size;pthread_attr_getstacksize(&attr,&size);
+            printf("create round=%d thread=%d stack=%zu\n",round,i,size);
+            int e=pthread_create(&threads[i],&attr,worker,(void*)(uintptr_t)(i+1));
+            pthread_attr_destroy(&attr);if(e){printf("ERROR %d\n",e);return 1;}
+        }
+        for(int i=0;i<16;i++){void *p;if(pthread_join(threads[i],&p)||p!=(void*)(uintptr_t)(i+1))return 2;}
+    }
+    puts("GLIBC_THREAD_STACKS_OK");return 0;
+}
