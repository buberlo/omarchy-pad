settings set target.disable-aslr false
settings set target.env-vars ISH_JIT=1 ISH_CRASHLOG=2
run
process status
register read pc lr sp x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28
memory read --format x --size 4 --count 12 $pc-16
bt 5
quit
