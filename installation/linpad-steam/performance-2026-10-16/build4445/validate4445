 if [ -x /tmp/jit-null-fault-probe ]; then /tmp/jit-null-fault-probe; fi
 echo ALL4445_PROBES_PASS
 cat /proc/ish/memory
} > "$OUT" 2>&1
wget -T 8 -q --post-file="$OUT" http://192.168.0.104:8766/report -O /dev/null
tail -15 "$OUT"
