#!/bin/sh
{ date; cat /etc/ishaudio/ishaudio.pa; cat /etc/pulse/daemon.conf; tail -70 /tmp/ishaudio/pulse.log; ls -l /dev/ish* /tmp/ishaudio; timeout 5 pactl list short sinks; timeout 5 pactl list short sink-inputs; timeout 5 pactl list short sources; timeout 5 pactl list short source-outputs; } >/tmp/audio-probe.txt 2>&1
wget -q --post-file=/tmp/audio-probe.txt http://192.168.0.104:8766/report -O /dev/null
