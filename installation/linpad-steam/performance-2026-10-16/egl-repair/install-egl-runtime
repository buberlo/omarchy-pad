#!/bin/sh
set -eu
BASE=${LINPAD_REPAIR_BASE:-http://192.168.0.104:8766}
stage=$(mktemp -d /tmp/linpad-egl.XXXXXX)
wget -T 60 -qO "$stage/payload.tar.gz" "$BASE/linpad-x86-egl-runtime.tar.gz"
printf '%s  %s\n' b80be0cfbf3146ed1c25d4d92a9dc51a775223968363902e66c7808771b455d1 "$stage/payload.tar.gz" | sha256sum -c -
tar -xzf "$stage/payload.tar.gz" -C "$stage"
sh "$stage/egl-repair/install.sh"
printf 'EGL_OVERLAY_DEVICE_INSTALL_PASS\n'
printf 'Repair evidence retained at %s\n' "$stage"
