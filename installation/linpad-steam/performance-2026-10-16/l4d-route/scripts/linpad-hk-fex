#!/bin/sh
# Steam launch wrapper for Hollow Knight: the proven FEX / Wayland / EGL / Venus route, in the
# same shape as the launcher that has been verified on this iPad by hand.
#
# Steam passes the game binary and its own arguments; the Unity arguments are appended here so
# the Steam side needs nothing but this line in the app's launch options:
#
#     /usr/local/bin/linpad-hk-fex %command%
#
# The compatibility tool is invoked exactly as its toolmanifest.vdf tells Steam to
# ("commandline" "/run %verb% --"), i.e. with one verb and the game command: the tool's run
# script consumes the verb and an optional --, then execs launch-game with the game command.
# Passing the verb twice would hand "run --" to launch-game as the executable.
#
# Every value below can be overridden from the environment, which is how the wrapper is tested
# against the real tool scripts on the Mac with a stub FEX and a stub game.
set -eu
STEAM_ROOT=${STEAM_ROOT:-${HOME:-/root}/.local/share/Steam}
GAME_DIR="$STEAM_ROOT/steamapps/common/Hollow Knight"
TOOL="$STEAM_ROOT/compatibilitytools.d/linpad-fex-native/run"

if [ ! -x "$TOOL" ]; then
    echo "linpad-hk-fex: the compatibility tool is missing: $TOOL" >&2
    exit 80
fi
# Steam normally starts the game with the install directory as the working directory; a relative
# program name only resolves there, so make sure when that is what we were given.
case "${1:-}" in
    /*) ;;
    *) [ -d "$GAME_DIR" ] && cd "$GAME_DIR" ;;
esac

: "${LINPAD_FEX_DISPLAY_MODE:=wayland}"
: "${LINPAD_EGL_MODE:=swrast}"
: "${LINPAD_FEX_BINARY:=/tmp/fex-hollow-egl}"
: "${LINPAD_EGL_FEX_BINARY:=/tmp/fex-game-crash-report}"
: "${LINPAD_FEX_REAL_BINARY:=/opt/fex/FEX-apple-m1-munmap}"
: "${SteamAppId:=367520}"
: "${SteamGameId:=367520}"
export LINPAD_FEX_DISPLAY_MODE LINPAD_EGL_MODE LINPAD_FEX_BINARY LINPAD_EGL_FEX_BINARY
export LINPAD_FEX_REAL_BINARY SteamAppId SteamGameId
unset WAYLAND_DEBUG EGL_LOG_LEVEL LIBGL_DEBUG FEX_MULTIBLOCK

for helper in "$LINPAD_FEX_BINARY" "$LINPAD_EGL_FEX_BINARY"; do
    [ -e "$helper" ] || echo "linpad-hk-fex: warning: $helper is missing" >&2
done

exec "$TOOL" run -- "$@" \
    -timestamps -force-wayland -force-vulkan \
    -screen-width 960 -screen-height 540 -screen-fullscreen 0 \
    -logFile /tmp/hollow4452-egl-unity.txt
