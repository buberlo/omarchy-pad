#!/bin/sh
cd '/root/.local/share/Steam/steamapps/common/Hollow Knight' || exit 80
export LINPAD_FEX_DISPLAY_MODE=wayland
export SteamAppId=367520 SteamGameId=367520 LINPAD_FEX_BINARY=/opt/fex/FEX-apple-m1-munmap
OUT=/tmp/hollow4445-wayland-fex.txt
{
 date
 /root/.local/share/Steam/compatibilitytools.d/linpad-fex-native/run run -- ./hollow_knight.x86_64 -force-wayland -force-vulkan -screen-width 960 -screen-height 540 -screen-fullscreen 0 -logFile /tmp/hollow4445-wayland-unity.txt
 echo GAME_EXIT=$?
 echo UNITY_LOG
 cat /tmp/hollow4445-wayland-unity.txt
 date
} > "$OUT" 2>&1
wget -T 8 -q --post-file="$OUT" http://192.168.0.104:8766/report -O /dev/null
tail -30 "$OUT"
