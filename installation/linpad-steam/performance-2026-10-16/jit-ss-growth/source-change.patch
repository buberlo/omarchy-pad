+static void growth_tests(void) {
+    enum { N = 32769 };
+    const addr_t base = UINT64_C(0x800000000000);
+    struct fiber_block *blocks = calloc(N, sizeof(*blocks)); assert(blocks);
+    struct jit_mm m; init(&m);
