+    for (unsigned i = 0; i < 1024; i++) add(&m, 0x80000 + i, 0);
+    CHECK(m.ss_size == 256 && m.ss_count == 1024 && m.ss_grow_at == 1024);
+    CHECK(allocation_checks == 2); // attempts at 256 and 512, not each insert
+    validate(&m);
