diff --git a/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp b/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
index b136ec5..7870f12 100644
--- a/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
+++ b/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
@@ -123,13 +123,15 @@ private:
 
       // Use madvise to set the full tracking region to zero.
       // This ensures unused pages are zero, while not having the backing pages consuming memory.
-      auto* MemoryAsBytes = reinterpret_cast<uint8_t*>(Region->UsedPages.Memory);
+      // ManagedSize is measured from the region base; base the madvise ranges on
+      // the region too, not the UsedPages bitset which starts one page in.
+      auto* RegionAsBytes = reinterpret_cast<uint8_t*>(Region);
       const auto TrackingRegionSize = Region->SlabInfo->RegionSize - ManagedSize;
-      ::madvise(MemoryAsBytes + ManagedSize, TrackingRegionSize, MADV_DONTNEED);
+      ::madvise(RegionAsBytes + ManagedSize, TrackingRegionSize, MADV_DONTNEED);
 
       // Use madvise to claim WILLNEED on the beginning pages for initial state tracking.
       // Improves performance of the following MemClear by not doing a page level fault dance for data necessary to track >170TB of used pages.
-      ::madvise(MemoryAsBytes, ManagedSize, MADV_WILLNEED);
+      ::madvise(RegionAsBytes, ManagedSize, MADV_WILLNEED);
 
       // Set our reserved pages
       Region->UsedPages.MemSet(NumManagedPages);
diff --git a/Source/Common/Config.cpp b/Source/Common/Config.cpp
index 676b2f5..de1c966 100644
--- a/Source/Common/Config.cpp
+++ b/Source/Common/Config.cpp
@@ -486,6 +486,13 @@ void LoadConfig(fextl::string ProgramName, char** const envp, const PortableInfo
   const bool IsPortable = PortableInfo.IsPortable;
   FEX::Config::InitializeConfigs(PortableInfo);
   FEXCore::Config::Initialize();
+
+  // FEX-static: hermetic config - honor FEX_* environment variables only, never
+  // config files that could silently reconfigure the binary (or slow down exec).
+  FEXCore::Config::AddLayer(CreateEnvironmentLayer(envp));
+  FEXCore::Config::Load();
+  return;
+
   if (!IsPortable) {
     FEXCore::Config::AddLayer(CreateGlobalMainLayer());
   }
