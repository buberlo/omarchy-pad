+        // microphone does this). Clear unmatched read notifications after one
+        // delivery; a later host EOF event still wakes us. POLLIN stays level
+        // triggered, and realfs_poll still decides whether to report HUP.
+        e[0].flags |= EV_CLEAR;
     }
