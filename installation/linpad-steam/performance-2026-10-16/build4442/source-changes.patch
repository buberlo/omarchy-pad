+        {.filter = EVFILT_EXCEPT, .flags = types & POLL_ERR ? EV_ADD | EV_CLEAR : EV_DELETE},
     };
     if (!(types & POLL_READ) && types & POLL_HUP) {
         // Set the low water mark really high so we'll only get woken up on a hangup
         e[0].fflags = NOTE_LOWAT;
         e[0].data = INT_MAX;
