+// Gate evidence helper: dump the raw contents of a CPU visible output buffer so that a
+// frame can be inspected from outside the compositor. No-op unless HYPR_PAD_SHM_DUMP is set.
+static void dumpShmFrame(const Aquamarine::SSHMAttrs& shm, const uint8_t* data) {
+    static const auto PATH = getenv("HYPR_PAD_SHM_DUMP");
+    if (!PATH || !*PATH || !data || shm.stride <= 0)
+        return;
+
+    const auto LEN = sc<size_t>(shm.stride) * sc<size_t>(shm.size.y);
+
+    const int  FD = open(PATH, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (FD < 0) {
+        Log::logger->log(Log::ERR, "shm: cannot open {} to dump a frame", PATH);
+        return;
+    }
+
+    size_t written = 0;
+    while (written < LEN) {
+        const auto N = write(FD, data + written, LEN - written);
+        if (N <= 0)
+            break;
+        written += sc<size_t>(N);
+    }
+
+    close(FD);
+
+    Log::logger->log(Log::DEBUG, "shm: dumped {} bytes of the output buffer to {}", written, PATH);
+}
+
+void CHyprGLRenderer::copyCurrentBufferToShm() {
+    if (!m_currentRenderbuffer)
+        return;
+
+    const auto BUFFER = m_currentRenderbuffer->m_hlBuffer.lock();
+    if (!BUFFER || BUFFER->type() != Aquamarine::BUFFER_TYPE_SHM)
+        return;
+
+    const auto SHM = BUFFER->shm();
+    if (!SHM.success) {
+        Log::logger->log(Log::ERR, "shm: output buffer has no CPU mapping, the frame is lost");
+        return;
+    }
+
+    // OpenGL::end() (already run above) resets renderData.currentFB, so ask the
+    // renderbuffer for the framebuffer the frame was just rendered into.
+    const auto FB = m_currentRenderbuffer->getFB();
+    if (!FB) {
+        Log::logger->log(Log::ERR, "shm: no framebuffer to copy the frame out of");
+        return;
+    }
+
+    if (!FB->readPixelsToBuffer(BUFFER, 0, 0, sc<uint32_t>(SHM.size.x), sc<uint32_t>(SHM.size.y))) {
+        Log::logger->log(Log::ERR, "shm: failed to copy the frame into the output buffer");
+        return;
+    }
+
+    const auto DATA = std::get<0>(BUFFER->beginDataPtr(0));
+    dumpShmFrame(SHM, DATA);
+}
