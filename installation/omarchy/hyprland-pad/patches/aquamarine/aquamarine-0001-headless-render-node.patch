diff --git a/src/allocator/SHM.cpp b/src/allocator/SHM.cpp
new file mode 100644
index 0000000..2e4be0b
--- /dev/null
+++ b/src/allocator/SHM.cpp
@@ -0,0 +1,196 @@
+#include <aquamarine/allocator/SHM.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include "FormatUtils.hpp"
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#ifndef MFD_CLOEXEC
+#define MFD_CLOEXEC 0x0001U
+#endif
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+#define SP CSharedPointer
+
+static constexpr uint32_t BYTES_PER_PIXEL = 4;
+
+// A 32-bit packed format is all a CPU-mapped buffer needs to be describable; the
+// renderer reads the pixels through the same fourcc it asked for.
+static uint32_t sanitizeFormat(uint32_t format) {
+    return format == DRM_FORMAT_INVALID ? DRM_FORMAT_XRGB8888 : format;
+}
+
+static size_t bufferLength(const Hyprutils::Math::Vector2D& size) {
+    return sc<size_t>(size.x) * sc<size_t>(size.y) * BYTES_PER_PIXEL;
+}
+
+// memfd_create is the point of this allocator, but it is not always available (old
+// kernels, sandboxes); an unlinked file in /dev/shm behaves identically for our use.
+static int createAnonymousFile(size_t len) {
+    int fd = -1;
+
+#ifdef __linux__
+    fd = memfd_create("aquamarine-shm", MFD_CLOEXEC);
+#endif
+
+    if (fd < 0) {
+        char path[] = "/dev/shm/aquamarine-shm-XXXXXX";
+        if (access("/dev/shm", W_OK) != 0)
+            snprintf(path, sizeof(path), "/tmp/aquamarine-shm-XXXXXX");
+
+        fd = mkstemp(path);
+        if (fd >= 0) {
+            unlink(path);
+            fcntl(fd, F_SETFD, FD_CLOEXEC);
+        }
+    }
+
+    if (fd < 0)
+        return -1;
+
+    if (ftruncate(fd, sc<off_t>(len))) {
+        close(fd);
+        return -1;
+    }
+
+    return fd;
+}
+
+Aquamarine::CSHMBuffer::CSHMBuffer(const SAllocatorBufferParams& params, Hyprutils::Memory::CWeakPointer<CSHMAllocator> allocator_,
+                                   Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain) : allocator(allocator_) {
+    if (!allocator)
+        return;
+
+    const auto FORMAT = sanitizeFormat(params.format);
+
+    attrs.size   = params.size;
+    attrs.format = FORMAT;
+    attrs.stride = sc<int>(params.size.x) * BYTES_PER_PIXEL;
+    attrs.offset = 0;
+    size         = attrs.size;
+
+    len = bufferLength(attrs.size);
+    if (len == 0) {
+        allocator->backend->log(AQ_LOG_ERROR, std::format("SHM: refusing to allocate a {} buffer", attrs.size));
+        return;
+    }
+
+    fd = createAnonymousFile(len);
+    if (fd < 0) {
+        allocator->backend->log(AQ_LOG_ERROR, std::format("SHM: failed to create a {} byte anonymous file: {}", len, strerror(errno)));
+        return;
+    }
+
+    data = sc<uint8_t*>(mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0));
+    if (data == MAP_FAILED) {
+        data = nullptr;
+        allocator->backend->log(AQ_LOG_ERROR, std::format("SHM: failed to map a {} byte buffer: {}", len, strerror(errno)));
+        return;
+    }
+
+    // start from black, not from uninitialized pages
+    memset(data, 0, len);
+
+    attrs.success = true;
+    attrs.fd      = fd;
+
+    allocator->backend->log(AQ_LOG_DEBUG,
+                            std::format("SHM: allocated a new buffer with size {} and format {} (stride {}, {} bytes, fd {})", attrs.size, fourccToName(attrs.format), attrs.stride,
+                                        len, fd));
+}
+
+Aquamarine::CSHMBuffer::~CSHMBuffer() {
+    if (data)
+        munmap(data, len);
+
+    if (fd >= 0)
+        close(fd);
+
+    events.destroy.emit();
+}
+
+eBufferCapability Aquamarine::CSHMBuffer::caps() {
+    return Aquamarine::eBufferCapability::BUFFER_CAPABILITY_DATAPTR;
+}
+
+eBufferType Aquamarine::CSHMBuffer::type() {
+    return Aquamarine::eBufferType::BUFFER_TYPE_SHM;
+}
+
+void Aquamarine::CSHMBuffer::update(const Hyprutils::Math::CRegion& damage) {
+    ;
+}
+
+bool Aquamarine::CSHMBuffer::isSynchronous() {
+    return true;
+}
+
+bool Aquamarine::CSHMBuffer::good() {
+    return attrs.success && data;
+}
+
+SSHMAttrs Aquamarine::CSHMBuffer::shm() {
+    return attrs;
+}
+
+std::tuple<uint8_t*, uint32_t, size_t> Aquamarine::CSHMBuffer::beginDataPtr(uint32_t flags) {
+    return {data, attrs.format, len};
+}
+
+void Aquamarine::CSHMBuffer::endDataPtr() {
+    ;
+}
+
+Aquamarine::CSHMAllocator::CSHMAllocator(Hyprutils::Memory::CWeakPointer<CBackend> backend_) : backend(backend_) {
+    ;
+}
+
+Aquamarine::CSHMAllocator::~CSHMAllocator() {
+    ;
+}
+
+SP<CSHMAllocator> Aquamarine::CSHMAllocator::create(Hyprutils::Memory::CWeakPointer<CBackend> backend_) {
+    auto allocator = SP<CSHMAllocator>(new CSHMAllocator(backend_));
+
+    allocator->self = allocator;
+
+    backend_->log(AQ_LOG_DEBUG, "Created a SHM allocator");
+
+    return allocator;
+}
+
+SP<IBuffer> Aquamarine::CSHMAllocator::acquire(const SAllocatorBufferParams& params, SP<CSwapchain> swapchain_) {
+    if (params.size.x < 1 || params.size.y < 1) {
+        backend->log(AQ_LOG_ERROR, std::format("SHM: couldn't allocate a buffer with invalid size {}", params.size));
+        return nullptr;
+    }
+
+    auto newBuffer = SP<CSHMBuffer>(new CSHMBuffer(params, self, swapchain_));
+
+    if (!newBuffer->good()) {
+        backend->log(AQ_LOG_ERROR, std::format("SHM: couldn't allocate a buffer with size {} and format {}", params.size, fourccToName(params.format)));
+        return nullptr;
+    }
+
+    buffers.emplace_back(newBuffer);
+    std::erase_if(buffers, [](const auto& b) { return b.expired(); });
+    return newBuffer;
+}
+
+Hyprutils::Memory::CSharedPointer<CBackend> Aquamarine::CSHMAllocator::getBackend() {
+    return backend.lock();
+}
+
+int Aquamarine::CSHMAllocator::drmFD() {
+    return -1;
+}
+
+eAllocatorType Aquamarine::CSHMAllocator::type() {
+    return AQ_ALLOCATOR_TYPE_SHM;
+}
