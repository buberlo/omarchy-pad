# Maintainer: Omarchy Pad (gate 0.4) <noreply@example.com>
#
# Hyprland 0.56.2, built like Omarchy's own hyprland package (same four carried patches,
# fetched into patches/hyprland/omarchy/) plus the Omarchy Pad gate 0.4 patches:
#
#   patches/hyprland/hyprland-0001-egl-render-node-device.patch
#     eglDeviceFromDRMFD() also matches EGL_DRM_RENDER_NODE_FILE_EXT, and initEGL()
#     reports failure instead of asserting, so a render-node-only host falls back from
#     EGL_PLATFORM_DEVICE_EXT to EGL_PLATFORM_GBM_KHR instead of aborting.
#
#   patches/hyprland/hyprland-0002-shm-output-buffer.patch
#     The output path accepts buffers that are not dmabufs: a CPU (shm) output buffer is
#     rendered into a GL texture, and the frame is copied back with glReadPixels when it
#     is presented. HYPR_PAD_SHM_DUMP=<path> additionally dumps the raw frame for
#     evidence.
#
# Build: see build.sh in this directory (drives an aarch64 Arch container).

pkgname=hyprland-pad
pkgver=0.56.2
pkgrel=1
pkgdesc='a highly customizable dynamic tiling Wayland compositor (Omarchy Pad: headless shm output)'
arch=(aarch64)
url="https://github.com/hyprwm/Hyprland"
license=(BSD-3-Clause)
depends=(cairo
         aquamarine
         libgcc
         'libstdc++'
         glibc
         glib2
         glslang
         hyprcursor
         hyprgraphics
         hyprland-guiutils
         hyprlang
         hyprutils
         hyprwire
         lcms2
         libdrm
         libglvnd
         libinput
         libx11
         libxcb
         libxcomposite
         libxcursor
         libxfixes
         libxkbcommon
         libxrender
         lua
         mesa
         muparser
         opengl-driver
         pango
         pixman
         re2
         tomlplusplus
         util-linux-libs
         wayland
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil
         xcb-util-wm
         xorg-xwayland)
makedepends=(cmake
             glaze
             hyprland-protocols
             hyprwayland-scanner
             meson
             ninja
             xorgproto)
provides=(wayland-compositor "hyprland=$pkgver")
conflicts=(hyprland)
_archive="hyprland-source"
source=("hyprland-source-v$pkgver.tar.gz::https://github.com/hyprwm/Hyprland/releases/download/v$pkgver/source-v$pkgver.tar.gz"
        hyprland-0001-egl-render-node-device.patch
        hyprland-0002-shm-output-buffer.patch
        hyprland-0003-headless-output-env.patch
        software-renderer.patch
        nvidia-egl-teardown.patch
        wl-output-global-grace.patch
        monitor-rule-vrr.patch)
sha256sums=('03ad3f5ef152ff44116ffd56fcf808486211ecabf4f0ba567108ee746ba5cd2e'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
	cd "$srcdir/$_archive"
	# Omarchy's carried patches first: the gate patches are generated on top of them.
	patch -Np1 --fuzz=0 -i "$srcdir/software-renderer.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/nvidia-egl-teardown.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/wl-output-global-grace.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/monitor-rule-vrr.patch"
	# Omarchy Pad gate 0.4
	patch -Np1 --fuzz=0 -i "$srcdir/hyprland-0001-egl-render-node-device.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/hyprland-0002-shm-output-buffer.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/hyprland-0003-headless-output-env.patch"
	# Omarchy builds Hyprland without an rpath and against a glaze that has no version range
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$srcdir/$_archive"
	make release PREFIX=/usr
}

package() {
	cd "$srcdir/$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find "$pkgdir" -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/hyprland/" LICENSE
}
